# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/

# Virtual envs
.venv/
venv/
env/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
desktop.ini

# Logs
logs/
*.log

# User data
projects/*.db
!projects/.gitkeep

# Secrets / local config (settings live in %APPDATA%, this is defensive)
settings.json
settings.json.tmp
*.key
.env

# Temp / scratch
*.tmp
*.temp
*.bak

# E2E run artifacts (tools/e2e_gui_phase.py writes the app log here)
_e2e_*.txt

# Bundled external binaries (~217 MB) - fetched by tools/fetch_binaries.py
bin/*.exe
bin/*.dll
